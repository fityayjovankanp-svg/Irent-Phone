<script>
  var pages = document.querySelectorAll('.page');
  var links = document.querySelectorAll('#switcher a');
  function show() {
    var id = location.hash.replace('#', '') || 'beranda';
    var found = false;
    pages.forEach(function (p) { var on = p.id === id; p.classList.toggle('active', on); if (on) found = true; });
    if (!found) { pages[0].classList.add('active'); id = pages[0].id; }
    links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + id); });
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', show);
  show();
</script>
