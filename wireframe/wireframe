  .brand { font-weight: bold; font-size: 16px; display: flex; align-items: center; gap: 8px; }
  .mark { width: 26px; height: 26px; border: 2px solid #333; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
  .nav nav a, .nav nav span { margin: 0 10px; text-decoration: none; }
  .nav nav a.on { text-decoration: underline; font-weight: bold; }
  .nav nav span { color: #888; }
  .pill { border: 1px dashed #888; border-radius: 12px; padding: 3px 10px; font-size: 11px; color: #555; }

  /* Komponen umum */
  h2 { margin: 0 0 6px; font-size: 22px; }
  h3 { margin: 0 0 12px; font-size: 16px; }
  .eyebrow { font-size: 11px; letter-spacing: 1px; color: #777; margin-bottom: 4px; }
  .mute { color: #666; font-size: 13px; }
  .box { border: 2px dashed #888; background: #f6f6f6; padding: 16px; }
  .ph { border: 2px solid #999; background: repeating-linear-gradient(45deg, #eee, #eee 8px, #f8f8f8 8px, #f8f8f8 16px); display: flex; align-items: center; justify-content: center; color: #777; font-size: 12px; min-height: 110px; }
  .btn { display: inline-block; border: 2px solid #333; padding: 8px 14px; background: #ddd; font-weight: bold; text-decoration: none; font-size: 13px; text-align: center; }
  .btn.block { display: block; width: 100%; }
  .btn.sm { padding: 3px 9px; font-size: 12px; }
  .btn.plain { background: #fff; }
  .input { border: 2px solid #888; background: #fff; padding: 9px 10px; color: #888; font-size: 13px; }
  .tag { display: inline-block; border: 1px solid #777; border-radius: 10px; padding: 1px 8px; font-size: 11px; margin-bottom: 6px; }
  .price { font-weight: bold; margin: 4px 0 10px; }
  .field { margin-bottom: 12px; }
  .field > label { display: block; font-weight: bold; font-size: 12px; margin-bottom: 4px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .card { border: 2px solid #333; padding: 10px; }
  .card .ph { margin-bottom: 8px; }
  .split { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; align-items: start; }
  .filters { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; border: 2px solid #888; padding: 12px; margin-bottom: 14px; }
  .filters label { display: block; font-weight: bold; font-size: 12px; margin-bottom: 4px; }
  .sumrow { display: flex; justify-content: space-between; padding: 5px 0; }
  .sumrow.total { border-top: 1px solid #888; font-weight: bold; margin-top: 4px; padding-top: 9px; }
  .center { text-align: center; }

  /* Tabel */
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th { background: #ddd; border: 1px solid #888; padding: 7px; text-align: left; }
  td { border: 1px solid #aaa; padding: 7px; }
  .pager { margin-top: 12px; text-align: right; font-size: 12px; }

  /* Layout admin */
  .admin { display: flex; min-height: 520px; }
  .side { width: 190px; border-right: 2px solid #333; padding: 16px; background: #f6f6f6; flex-shrink: 0; }
  .side .menu { line-height: 2.2; font-size: 13px; margin-top: 14px; }
  .side .menu .cur { font-weight: bold; text-decoration: underline; }
  .main { flex: 1; padding: 20px; min-width: 0; }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; gap: 10px; flex-wrap: wrap; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  .stat .n { font-size: 28px; font-weight: bold; }

