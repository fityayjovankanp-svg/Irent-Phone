  .page { display: none; max-width: 1000px; margin: 24px auto; background: #fff; border: 2px solid #333; min-height: 560px; }
  .page.active { display: block; }
  .label { font-size: 12px; color: #666; padding: 6px 16px; background: #f3f3f3; border-bottom: 1px dashed #999; }
  .content { padding: 20px; }

