    .grid4, .grid3, .split, .filters, .stats, .row2 { grid-template-columns: 1fr 1fr; }
    .split { grid-template-columns: 1fr; }
    .admin { flex-direction: column; }
    .side { width: 100%; border-right: 0; border-bottom: 2px solid #333; }
    .main table { display: block; overflow-x: auto; }
  }
</style>
